generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String     @id 
  title     String     @unique
  content   String?    @default("")
  parentId  String? 
  parent    Document?  @relation("DocumentToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("DocumentToChildren")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}